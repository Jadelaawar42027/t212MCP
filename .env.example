# ---- Trading 212 ----
# live = real money account, demo = practice account
TRADING212_ENV=demo
# Create at Trading 212 app > Settings > API (Beta). Enable ONLY read scopes:
# account, portfolio, history:orders, history:dividends, history:transactions, metadata, pies:read
TRADING212_API_KEY=
TRADING212_API_SECRET=
# Optional tuning
# TRADING212_TIMEOUT_SECONDS=15
# TRADING212_MAX_PAGES=20

# ---- Server / OAuth ----
# Public origin of the deployment, no trailing slash, no path.
PUBLIC_BASE_URL=http://localhost:8000
# Password for the single owner login. 12+ chars; use a long random one.
OWNER_PASSWORD=
# Optional but recommended: base32 TOTP secret (generate: uv run python -c "import pyotp; print(pyotp.random_base32())")
OWNER_TOTP_SECRET=
# 32+ random chars used to sign tokens (generate: openssl rand -base64 48). Rotating it signs you out everywhere.
OAUTH_SIGNING_KEY=

# Optional: only accept /mcp calls from these CIDRs (Anthropic egress is 160.79.104.0/21).
# Leave empty if you also use Claude Code from your laptop.
# ALLOWED_CIDRS=160.79.104.0/21
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_SECONDS=2592000
# LOG_LEVEL=INFO

# ---- Revolut via Enable Banking (restricted production mode) ----
# Application ID from the Enable Banking Control Panel.
ENABLE_BANKING_APP_ID=
# Local: path to the app's private key .pem (keep it outside the repo, or anywhere: *.pem is git-ignored).
ENABLE_BANKING_KEY_PATH=
# Railway: base64 of the PEM instead (base64 -i app.pem | tr -d '\n'). The path wins if both are set.
# ENABLE_BANKING_PRIVATE_KEY_B64=
# Printed by `uv run python scripts/link_revolut.py`. Renew when consent_status says so.
ENABLE_BANKING_SESSION_ID=
# JSON: identification_hash (stable across re-consents), IBAN or uid -> label.
ACCOUNT_LABELS={}
# Monthly living-expenses budget in your main currency.
LIVING_BUDGET=1500
# Pocket/account whose spending counts toward LIVING_BUDGET (label, pocket name or IBAN tail).
LIVING_ACCOUNT=Living Expenses Monthly
# Optional: your name(s) as they appear on transfers to your own accounts at other banks (comma-separated).
# OWNER_NAMES=
# Optional tuning
# ENABLE_BANKING_CACHE_TTL_HOURS=6     # 4-24; bank allows ~4 background pulls/day per account
# ENABLE_BANKING_HISTORY_DAYS=90
# TIMEZONE=Europe/Madrid
